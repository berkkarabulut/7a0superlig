{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber() && newData.child('t').val() <= now",
        "$other": { ".validate": "$other === 't'" }
      }
    }
  }
}
